{
  "compilerOptions": {
    // Target and Module Settings
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],

    // Strict Type Checking
    "strict": true,
    "noImplicitAny": false, // Allow for Web3 compatibility
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false, // Allow for Web3 flexibility

    // Additional Checks
    "noUnusedLocals": false, // Allow during development
    "noUnusedParameters": false, // Allow during development
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    // Module Resolution
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/lib/security/*": ["./src/lib/security/*"],
      "@/lib/errors/*": ["./src/lib/errors/*"],
      "@/lib/utils/*": ["./src/lib/utils/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/types/*": ["./src/types/*"],
      "@/config/*": ["./src/config/*"],
      "@/public/*": ["./public/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/services/*": ["./src/services/*"],
      "@/store/*": ["./src/store/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/utils/*": ["./src/utils/*"],
      "@/tests/*": ["./tests/*"],
      "@/contexts/*": ["./src/contexts/*"],
      "@/app/*": ["./src/app/*"],
      "@/pages/*": ["./src/pages/*"],
      "@/styles/*": ["./src/styles/*"],
      "@/assets/*": ["./src/assets/*"],
      "@/api/*": ["./src/app/api/*"],
      "@/components/ui/*": ["./src/components/ui/*"],
      "@/components/forms/*": ["./src/components/forms/*"],
      "@/components/layout/*": ["./src/components/layout/*"],
      "@/components/features/*": ["./src/components/features/*"],
      "@/lib/web3/*": ["./src/lib/web3/*"],
      "@/lib/telegram/*": ["./src/lib/telegram/*"],
      "@/lib/bridge/*": ["./src/lib/bridge/*"],
      "@/lib/aml-kyc/*": ["./src/lib/aml-kyc/*"],
      "@/lib/travel-rule/*": ["./src/lib/travel-rule/*"],
      "@/lib/wallet/*": ["./src/lib/wallet/*"],
      "@/lib/ai/*": ["./src/lib/ai/*"],
      "@/lib/monitoring/*": ["./src/monitoring/*"],
      "@/mcp/*": ["./src/mcp/*"],
      "@/mobile/*": ["./src/mobile/*"],
      "@/gravmemorial/*": ["./src/gravmemorial/*"],
      "@/components/atr/*": ["./src/components/atr/*"],
      "@/components/dex/*": ["./src/components/dex/*"],
      "@/components/telegram/*": ["./src/components/telegram/*"]
    },

    // Emit and Declaration
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": false,
    "importHelpers": false,

    // Advanced Options
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,

    // Experimental Features
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Web3 Specific Settings
    "allowJs": true, // Allow JS files for Web3 libraries
    "checkJs": false, // Don't type check JS files
    "maxNodeModuleJsDepth": 0, // Don't transpile node_modules

    // Performance
    "assumeChangesOnlyAffectDirectDependencies": true,
    "disableSourceOfProjectReferenceRedirect": true,
    "disableReferencedProjectLoad": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".next/types/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.js",
    "tests/**/*.ts",
    "tests/**/*.js",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "mobile-app/**",
    "src/agents/**",
    "src/components/staking/**/*",
    "src/components/profile/social-integration.tsx",
    "src/components/dex/dual-currency-system.tsx",
    "src/components/dex/**/*",
    "normal-dance-vercel/**",
    "src/agents/**",
    "src/components/unified/**/*",
    "src/lib/defi/**/*",
    "src/lib/did/**/*",
    "src/lib/layer-2/**/*",
    "src/lib/web3/nft-enhanced-system.ts",
    "src/lib/web3/web3-service.ts",
    "out/**",
    ".next/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    ".storybook/**",
    "storybook-static/**"
  ],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}