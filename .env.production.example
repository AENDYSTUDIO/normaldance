# Production Environment Variables for Vercel
# Copy this file and fill in your actual values

# App Configuration
NODE_ENV=production
PORT=3000

# Database (Use Vercel Postgres or external DB)
DATABASE_URL=postgresql://user:password@host:5432/normaldance

# Session & Auth
SESSION_SECRET=generate_random_32_character_string_here
OAUTH_SERVER_URL=https://normaldance.vercel.app

# Frontend Environment Variables
VITE_APP_TITLE=NORMAL DANCE
VITE_APP_LOGO=https://placehold.co/128x128/E1E7EF/1F2937?text=ND
VITE_OAUTH_PORTAL_URL=https://normaldance.vercel.app
VITE_APP_ID=normaldance

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username

# Web3 - Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# Web3 - Ethereum
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_NETWORK=mainnet

# IPFS Storage
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# AWS S3 (if using)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=normaldance-uploads

# Sentry (Error Tracking - Optional)
SENTRY_DSN=your_sentry_dsn

# Redis (Caching - Optional)
REDIS_URL=redis://user:password@host:6379
